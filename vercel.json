{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/receitas",
      "destination": "/receitas/index.html"
    },
    {
      "source": "/upsell",
      "destination": "/upsell/index.html"
    },
    {
      "source": "/cardapio",
      "destination": "/cardapio/index.html"
    }
  ],
  "functions": {
    "api/recipes.mjs": {
      "includeFiles": "private/recipes.enc.json"
    },
    "api/cardapio.mjs": {
      "includeFiles": "private/recipes.enc.json"
    }
  },
  "headers": [
    {
      "source": "/receitas/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/cardapio/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
